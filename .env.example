# chaostoolkit — copy to .env; every variable is optional.
PORT=4060

# Extra non-loopback hostnames live injections may target (comma-separated). Empty = loopback only; production hosts stay denied.
CHAOS_ALLOWED_HOSTS=

# Kill switch for live fault injection (mode live_probe / CLI --live). Anything but "true" keeps the
# service dry-run only: a live request is refused (HTTP 403 LIVE_MODE_DISABLED, CLI exit 3) before any
# probe, injection or child process. It is process configuration only - a request cannot enable it.
CHAOS_LIVE_ENABLED=false
